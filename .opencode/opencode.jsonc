{
  "$schema": "https://opencode.ai/config.json",

  // Alias for "any lightweight sub-task". Marked deprecated in schema, but kept
  // as a defensive net for code paths that don't go through `agent.<name>.model`.
  // 2026-10-29 temporary probe: big-pickle is the opencode.ai "default" free
  // model (the *only* one explicitly stated as always-available in
  // https://opencode.ai/go). We're using it here to test whether the 429
  // `FreeUsageLimitError` is per-model or per-account.
  "small_model": "opencode/big-pickle",

  // Modern, non-deprecated override of the built-in `title` agent.
  // Mirrors the build model on purpose: if the title agent stayed on
  // mimo-v2.6-flash-free, a shared quota would still 429 the title
  // generation and we couldn't tell which bucket the failure came from.
  "agent": {
    "title": {
      "model": "opencode/big-pickle",
    },
  },

  // Permission overrides (2026-10-29).
  //
  // The default-render keeps `external_directory` as `action: "ask"`, which
  // presents an interactive prompt when the agent wants to read or write
  // anything outside the project root (e.g. `~/.config/gh/hosts.yml`,
  // `~/.local/share/opencode/snapshot/...`). In a CI environment there is
  // no human to answer, so the run silently waits up to the 60-minute job
  // timeout. Observed in the wild: a triage run hung for ~22 minutes after
  // a `gh auth status` invocation before we cancelled the job.
  //
  // The runner is ephemeral — nothing on it survives the job — so an
  // unrestricted `external_directory` is safe. `question` is already
  // denied in the session metadata, so the agent still can't ask us
  // anything mid-run.
  "permissions": [{ "permission": "external_directory", "pattern": "*", "action": "allow" }],
}
